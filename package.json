{
  "name": "the-counter",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "build:site": "tsc -b && vite build --base=/experiments/the-counter/",
    "lint": "oxlint",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "assets:optimize": "node scripts/optimize-assets.mjs",
    "audio:generate": "node scripts/generate-voices.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "kokoro-js": "^1.2.1",
    "oxlint": "^1.88.0",
    "sharp": "^0.35.5",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "sharp": "$sharp"
  }
}
